# ==========================================
# Variables de Entorno - Todo List (PWA / Web)
# ==========================================

# Conexión a la base de datos Turso / libSQL
# Puede especificarse con protocolo libsql:// o https://
VITE_TURSO_URL=libsql://tu-db.aws-us-east-2.turso.io
# Opcional (alias alternativo):
# VITE_TURSO_DATABASE_URL=libsql://tu-db.aws-us-east-2.turso.io

# Token de autenticación de Turso
VITE_TURSO_AUTH_TOKEN=tu_token_aqui

# Identificador de usuario para particionamiento multi-tenant
VITE_USER_ID=user_local_123
